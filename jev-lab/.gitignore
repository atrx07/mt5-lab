# Local secrets and credentials
.env
.env.*
!.env.example
*.key
*.pem

# Python and local tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Large or regenerable data; manifests remain versioned
data/raw/*
!data/raw/.gitkeep
data/derived/*
!data/derived/.gitkeep
