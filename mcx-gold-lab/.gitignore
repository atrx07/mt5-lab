# mcx-gold-lab ignores: local-only / generated / secrets
__pycache__/
*.pyc
*.pyo
.env
.env.*
!.env.example

# raw captures stay out of git; curated .csv archives are allowed
# (plain CSV: the push path cannot carry binary, and daily files are KB-scale)
data/raw/*
!data/raw/.gitkeep
!data/raw/*.csv

# synthetic scratch
data/raw/SYNTHETIC_*

# editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
